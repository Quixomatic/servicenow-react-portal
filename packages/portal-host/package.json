{
  "name": "@x-312987/portal-host",
  "version": "1.1.0",
  "private": false,
  "description": "React Portal host component",
  "keywords": [
    "ServiceNow",
    "Next Experience UI Component",
    "@x-312987/portal-host"
  ],
  "readme": "./README.md",
  "engines": {
    "node": ">=22"
  },
  "module": "src/index.js",
  "scripts": {
    "build:css": "tailwindcss -i src/styles/tailwind.css -o src/styles/tailwind.generated.css --minify",
    "dev": "pnpm build:css && snc ui-component develop --port 8081",
    "verify": "patch-servicenow-babel --verify && servicenow-shadcn-fix --check",
    "deploy": "pnpm build:css && patch-servicenow-babel --verify && snc ui-component deploy"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@quixomatic/ui-renderer-react-simple": "^2.1.1",
    "@servicenow/sass-kit": "latest",
    "@servicenow/ui-core": "24.1.1",
    "@servicenow/ui-renderer-react": "link:react-shim",
    "@servicenow/ui-renderer-snabbdom": "24.1.1",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "react": "link:react-shim",
    "react-dom": "link:react-shim"
  },
  "devDependencies": {
    "@babel/runtime": "7.28.3",
    "@tailwindcss/cli": "^4.3.5",
    "ajv": "6.12.6",
    "sass": "^1.108.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
