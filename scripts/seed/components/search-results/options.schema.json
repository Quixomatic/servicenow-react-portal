{
  "type": "object",
  "properties": {
    "resultsPage": {
      "type": "string",
      "title": "This page's route"
    },
    "sources": {
      "type": "array",
      "title": "Sources (in order)",
      "items": {
        "type": "string",
        "enum": [
          "catalog",
          "knowledge",
          "requests",
          "incidents",
          "pages"
        ]
      }
    },
    "catalogPage": {
      "type": "string",
      "title": "Catalog page route"
    },
    "kbPage": {
      "type": "string",
      "title": "Knowledge page route"
    },
    "recordPage": {
      "type": "string",
      "title": "Record form page route"
    },
    "pageSize": {
      "type": "integer",
      "title": "Results per page",
      "minimum": 5,
      "maximum": 50
    },
    "perSource": {
      "type": "integer",
      "title": "Hits per source on All",
      "minimum": 1,
      "maximum": 10
    },
    "suggestions": {
      "type": "array",
      "title": "Suggestions (empty search)",
      "items": {
        "type": "string"
      }
    }
  }
