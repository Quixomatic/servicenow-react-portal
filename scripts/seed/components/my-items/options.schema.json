    "recordPage": {
      "type": "string",
      "title": "Record form page route"
    },
    "listPage": {
      "type": "string",
      "title": "List page route (View all; empty = none)"
    },
    "catalogPage": {
      "type": "string",
      "title": "Catalog page route"
    },
    "live": {
      "type": "boolean",
      "title": "Live updates"
    }
